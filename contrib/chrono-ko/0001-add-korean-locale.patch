@@ -0,0 +1,46 @@
+import * as chrono from "../../src/";
+import { testSingleCase } from "../test_util";
+
+// Reference: 2012-08-10 (Friday) 12:00. 년 = year, 월 = month, 일 = day.
+
+test("Test - Single Expression", function () {
+    // "2012년 8월 15일" = Aug 15, 2012
+    testSingleCase(chrono.ko, "2012년 8월 15일", new Date(2012, 8 - 1, 10, 12), (result) => {
+        expect(result.text).toBe("2012년 8월 15일");
+        expect(result.start.get("year")).toBe(2012);
+        expect(result.start.get("month")).toBe(8);
+        expect(result.start.get("day")).toBe(15);
+    });
+
+    // "8월 15일 광복절" = "Aug 15, Liberation Day" (year implied from the reference)
+    testSingleCase(chrono.ko, "8월 15일 광복절", new Date(2012, 8 - 1, 10, 12), (result) => {
+        expect(result.text).toBe("8월 15일");
+        expect(result.start).toBeDate(new Date(2012, 8 - 1, 15, 12));
+    });
+
+    // Spaces are often omitted in chats: "8월15일"
+    testSingleCase(chrono.ko, "8월15일", new Date(2012, 8 - 1, 10, 12), (result) => {
+        expect(result.start).toBeDate(new Date(2012, 8 - 1, 15, 12));
+    });
+
+    // "8월 15일 오후 7시" = Aug 15, 7 PM
+    testSingleCase(chrono.ko, "8월 15일 오후 7시", new Date(2012, 8 - 1, 10, 12), (result) => {
+        expect(result.text).toBe("8월 15일 오후 7시");
+        expect(result.start).toBeDate(new Date(2012, 8 - 1, 15, 19));
+    });
+});
+
+test("Test - Range Expression", function () {
+    // "11월 1일부터 11월 3일까지" = "from Nov 1 until Nov 3" (부터 = from, 까지 = until)
+    testSingleCase(chrono.ko, "11월 1일부터 11월 3일까지 휴가", new Date(2012, 8 - 1, 10, 12), (result) => {
+        expect(result.text).toBe("11월 1일부터 11월 3일");
+        expect(result.start).toBeDate(new Date(2012, 11 - 1, 1, 12));
+        expect(result.end).toBeDate(new Date(2012, 11 - 1, 3, 12));
+    });
+
+    // "월요일~금요일" = Monday–Friday
+    testSingleCase(chrono.ko, "월요일~금요일", new Date(2012, 8 - 1, 10, 12), (result) => {
+        expect(result.start).toBeDate(new Date(2012, 8 - 1, 13, 12));
+        expect(result.end).toBeDate(new Date(2012, 8 - 1, 17, 12));
+    });
+});
diff --git a/test/ko/ko_time_exp.test.ts b/test/ko/ko_time_exp.test.ts
new file mode 100644
index 0000000..21f43bc
--- /dev/null
+++ b/test/ko/ko_time_exp.test.ts
@@ -0,0 +1,58 @@
+import * as chrono from "../../src/";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+// Reference: 2012-08-10 (Friday) 12:00. 시 = hour, 분 = minute, 반 = half past, 오전 = AM, 오후 = PM.
+
+test("Test - Single Expression", function () {
+    // 오후 3시 = 3 PM
+    testSingleCase(chrono.ko, "오후 3시", new Date(2012, 8 - 1, 10, 12), (result) => {
+        expect(result.text).toBe("오후 3시");
+        expect(result.start.get("hour")).toBe(15);
+        expect(result.start.get("meridiem")).toBe(chrono.Meridiem.PM);
+        expect(result.start).toBeDate(new Date(2012, 8 - 1, 10, 15));
+    });
+
+    // 오전 10시 30분 = 10:30 AM
+    testSingleCase(chrono.ko, "오전 10시 30분", new Date(2012, 8 - 1, 10, 12), (result) => {
+        expect(result.start).toBeDate(new Date(2012, 8 - 1, 10, 10, 30));
+    });
+
+    // 3시 반 = half past 3 (no AM/PM given: kept as 3)
+    testSingleCase(chrono.ko, "3시 반", new Date(2012, 8 - 1, 10, 12), (result) => {
+        expect(result.text).toBe("3시 반");
+        expect(result.start.get("hour")).toBe(3);
+        expect(result.start.get("minute")).toBe(30);
+    });
+
+    // 저녁 7시 = 7 in the evening
+    testSingleCase(chrono.ko, "저녁 7시", new Date(2012, 8 - 1, 10, 12), (result) => {
+        expect(result.start.get("hour")).toBe(19);
+    });
+
+    // 새벽 2시 = 2 in the early morning
+    testSingleCase(chrono.ko, "새벽 2시", new Date(2012, 8 - 1, 10, 12), (result) => {
+        expect(result.start.get("hour")).toBe(2);
+        expect(result.start.get("meridiem")).toBe(chrono.Meridiem.AM);
+    });
+
+    // 밤 12시 = 12 at night (midnight)
+    testSingleCase(chrono.ko, "밤 12시", new Date(2012, 8 - 1, 10, 12), (result) => {
+        expect(result.start.get("hour")).toBe(0);
+    });
+
+    // 세 시 = 3 o'clock, written with a native Korean number
+    testSingleCase(chrono.ko, "세 시", new Date(2012, 8 - 1, 10, 12), (result) => {
+        expect(result.start.get("hour")).toBe(3);
+    });
+
+    // 열두시 반 = half past 12 (native number, no space)
+    testSingleCase(chrono.ko, "열두시 반", new Date(2012, 8 - 1, 10, 12), (result) => {
+        expect(result.start.get("hour")).toBe(12);
+        expect(result.start.get("minute")).toBe(30);
+    });
+});
+
+test("Test - Negative cases", function () {
+    // "2시간" = "2 hours" (a duration, not 2 o'clock)
+    testUnexpectedResult(chrono.ko, "2시간 걸려요");
+});
