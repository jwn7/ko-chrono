{
  "name": "ko-chrono",
  "version": "0.4.1",
  "description": "한국어 자연어 날짜/시간 파서 — '다음주 화요일 오후 3시' → Date. Korean natural language date/time parser for JavaScript/TypeScript: relative dates, weekdays, deadlines, recurring events (RRULE), lunar holidays, ICS export. Zero dependencies.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "playground": "npm run build && npx serve ."
  },
  "keywords": [
    "korean",
    "한국어",
    "hangul",
    "date",
    "time",
    "datetime",
    "date-parser",
    "time-parser",
    "parser",
    "natural-language",
    "nlp",
    "날짜",
    "시간",
    "일정",
    "chrono",
    "chrono-node",
    "relative-date",
    "weekday",
    "deadline",
    "recurrence",
    "rrule",
    "ical",
    "ics",
    "calendar",
    "schedule",
    "event",
    "lunar",
    "holiday",
    "typescript",
    "zero-dependency"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwn7/ko-chrono.git"
  },
  "homepage": "https://github.com/jwn7/ko-chrono#readme",
  "bugs": "https://github.com/jwn7/ko-chrono/issues",
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
